{
    "name": "techpearlsolutions/udyamventures",
    "description": "Udyam Ventures Enterprise CMS",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "dompdf/dompdf": "^3.1",
        "endroid/qr-code": "^5.0",
        "phpmailer/phpmailer": "^6.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php",
            "app/Helpers/url.php",
            "app/Helpers/assets.php",
            "app/Helpers/menu.php"
        ]
    },
    "scripts": {
        "tenders:deadlines": "php scripts/tender-deadlines.php",
        "payments:reconcile": "php scripts/reconcile-payments.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
