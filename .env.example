APP_NAME="Udyam Ventures"
APP_ENV=production
APP_DEBUG=false
# Root deployment:
# APP_URL=https://udyamventures.com
# APP_BASE_PATH=
# Subfolder deployment:
APP_URL=https://udyamventures.com/demo
APP_BASE_PATH=/demo
TIMEZONE=Asia/Kolkata
SESSION_NAME=UDYAM_SESSION
# Optional. Leave empty to use the server's configured PHP session directory.
SESSION_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=udyamventures
DB_USERNAME=root
DB_PASSWORD=
MEDIA_DISK=local

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=noreply@udyamventures.com
SMTP_PASSWORD=
SMTP_FALLBACK_MAIL=true
CONSULTATION_TO_EMAIL=projects@udyamventures.com

# Comma-separated days before closing when subscribed customers and admins are alerted.
TENDER_DEADLINE_REMINDER_DAYS=7,3,1

# PayYantra checkout. Demo mode never contacts a bank and is safe for testing.
PAYYANTRA_MODE=demo
PAYYANTRA_ORDER_ENDPOINT=
PAYYANTRA_API_KEY=
PAYYANTRA_WEBHOOK_SECRET=
